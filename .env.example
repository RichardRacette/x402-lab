# SELLER: public receiving address only. Safe to expose.
X402_PAY_TO=0xYOUR_RECEIVING_WALLET_ADDRESS

# BUYER: TESTNET-ONLY private key for a disposable wallet.
# NEVER commit this value. Do not use your primary wallet.
EVM_PRIVATE_KEY=0xYOUR_DISPOSABLE_TESTNET_PRIVATE_KEY

# Existing x402-lab service URL.
X402_API_URL=http://localhost:4021

# OPTIONAL PRODUCT-VALIDATION PROVIDER: CareerOneStop / U.S. Department of Labor data.
# Request Web API access from CareerOneStop and keep both values private.
# Role Reality validation must remain able to run fixture tests when these are absent.
CAREERONESTOP_USER_ID=your_careeronestop_user_id
CAREERONESTOP_API_TOKEN=your_careeronestop_api_token
