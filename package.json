{
  "name": "x402-lab",
  "version": "0.1.0",
  "private": false,
  "description": "Experimental x402 machine-commerce lab for paid agent APIs, bounded autonomous purchasing, demand research, and security tooling.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "server": "tsx src/server.ts",
    "buy": "tsx src/client.ts",
    "shopper": "tsx src/shopper-cli.ts",
    "kiroshi:scan": "tsx src/kiroshi/scan.ts",
    "kiroshi": "tsx src/kiroshi/serve.ts",
    "buyer-trace:preflight": "tsx src/buyer-trace-preflight-cli.ts",
    "market:fixtures": "tsx src/market-observatory/cli.ts fixtures",
    "market:collect": "tsx src/market-observatory/cli.ts collect-x402stats",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@x402/core": "2.23.0",
    "@x402/evm": "2.23.0",
    "@x402/express": "2.24.0",
    "@x402/extensions": "2.24.0",
    "@x402/fetch": "2.24.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "viem": "^2.37.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
